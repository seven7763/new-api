# Docs AI assistant — SERVER ONLY (never VITE_* for secrets).
# Copy to .env.local for local dev. Production: export on the sidecar host.
#
# Dev: Vite middleware reads these via loadEnv (not shipped to the browser).
# Prod: run `bun server/assistant-proxy.ts` and point nginx at it.

DOCS_ASSISTANT_KEY=
# Optional:
# DOCS_ASSISTANT_BASE=https://jp.daoxe.com/v1
# DOCS_ASSISTANT_MODEL=llama-3.3-70b
# DOCS_ASSISTANT_PORT=8788

# --- Telegram docs bot (bun run assistant:tg) ---
# BotFather token; never commit real tokens.
DOCS_TG_BOT_TOKEN=
# Supergroup / channel numeric id (e.g. -100xxxxxxxxxx)
DOCS_TG_CHAT_ID=
# 1 = only reply when @mentioned / replied-to / /ask (recommended in groups)
# DOCS_TG_REQUIRE_MENTION=1
# DOCS_TG_DOCS_BASE=https://daoxe.com/docs
# DOCS_TG_COOLDOWN_MS=4000
